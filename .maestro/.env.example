[TEMPLATE]
# Copy to .maestro/.env — LaLarente E2E test credentials
# Fill in passwords from your password manager, then run Maestro flows.
#
# Profiles:
#   OWNER  → indraj.navin@gmail.com (role: admin)
#   TENANT → navin.indraj@yahoo.com  (role: tenant)
#   VENDOR → e2e-vendor@lalarente.com (role: vendor) — dedicated E2E vendor account
#
# NOTE: VENDOR_EMAIL is NOT the same as OWNER_EMAIL anymore.
# The old indraj.navin@gmail.com has role=admin, which broke vendor flows.
TENANT_EMAIL=navin.indraj@yahoo.com
TENANT_PASSWORD=
OWNER_EMAIL=indraj.navin@gmail.com
OWNER_PASSWORD=
VENDOR_EMAIL=e2e-vendor@lalarente.com
VENDOR_PASSWORD=
# E2E vendor registration defaults (used with --env override for unique emails)
VENDOR_E2E_EMAIL=e2e-vendor@lalarente.com
VENDOR_E2E_PASSWORD=
VENDOR_E2E_FULL_NAME=E2E Test Vendor
VENDOR_E2E_BUSINESS_NAME=E2E Test Plumbing
